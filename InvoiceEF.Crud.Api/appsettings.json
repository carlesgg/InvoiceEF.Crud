{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InvoiceDb": "Server=localhost;Database=InvoiceEF;Integrated Security=True;TrustServerCertificate=True;",
    "InvoiceDocker": "Server=host.docker.internal,15000;Database=InvoiceEF;User Id=sa;Password=Triggerdb!!!!;TrustServerCertificate=true;",
    "InvoiceDocker2": "Server=.,15000;Database=InvoiceEF;User Id=sa;Password=Triggerdb!!!!;TrustServerCertificate=true;",
    "RedisConnection": "localhost:6379"
  },
  "Proxies": {
    "Forbes": "https://forbes-api.vercel.app/"
  }
}
